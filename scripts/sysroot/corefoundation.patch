+    if (_CFTypeGetClass(cf) != __CFISAForTypeID(newTypeID)) {
+        ((CFRuntimeBase *)cf)->_cfisa = __CFISAForTypeID(newTypeID);
+    }
 #endif
 }
 
@@ -1717,7 +1723,7 @@ static void _CFRelease(CFTypeRef CF_RELEASES_ARGUMENT cf) {
